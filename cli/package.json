{
  "name": "json-eyes",
  "version": "0.2.1",
  "description": "JSON'u salt okunur paylasim linkine ceviren ve terminalde inceleyen CLI (IATA NDC yanitlari icin JSON Eyes araci).",
  "keywords": [
    "json",
    "cli",
    "share",
    "json-viewer",
    "iata",
    "ndc",
    "jq",
    "terminal"
  ],
  "license": "MIT",
  "author": "osmanasaf",
  "homepage": "https://github.com/osmanasaf/json-eyes/tree/master/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmanasaf/json-eyes.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/osmanasaf/json-eyes/issues"
  },
  "type": "module",
  "bin": {
    "jse": "dist/jse.mjs",
    "json-eyes": "dist/jse.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/jse.mjs --banner:js=\"#!/usr/bin/env node\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "dev": "npm run build && node dist/jse.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/cli.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18"
  }
}
